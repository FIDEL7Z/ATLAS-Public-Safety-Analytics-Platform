# Raw and processed data (large files, not versioned)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fase 6 — dataset de produção (gerado por src.production.build_dataset).
# O artefato de serving (~17 MB) É versionado — é o que o deploy no Render
# publica junto com a API. Rebuild: python -m src.production.build_dataset.
data/production/*
!data/production/.gitkeep
!data/production/atlas_public.duckdb
!data/production/manifest.json

# Environment
.env
venv/
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Power BI — o .pbix é binário e pode ficar grande com o modelo importado
# (fact table de 5,29M linhas); o que importa para o repositório é o
# tema/medidas/DDL versionados em texto (powerbi/*.json, powerbi/*.dax, sql/).
powerbi/*.pbix
*.pbix.bak
