{
  "name": "Sentinel.io — Public Safety Analytics",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#898781",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#f0efec",
  "minimum": "#e34948",
  "textClasses": {
    "callout": { "fontSize": 45, "fontFamily": "Segoe UI Light", "color": "#0b0b0b" },
    "title": { "fontSize": 14, "fontFamily": "Segoe UI Semibold", "color": "#0b0b0b" },
    "header": { "fontSize": 12, "fontFamily": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label": { "fontSize": 10, "fontFamily": "Segoe UI", "color": "#52514e" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#f9f9f7" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0b0b0b" } }, "fontSize": 32 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#898781" } }, "fontSize": 11 }]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "axisColor": { "solid": { "color": "#c3c2b7" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "axisColor": { "solid": { "color": "#c3c2b7" } } }]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "axisColor": { "solid": { "color": "#c3c2b7" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "axisColor": { "solid": { "color": "#c3c2b7" } } }],
        "lineStyles": [{ "strokeWidth": 2 }]
      }
    }
  }
}
