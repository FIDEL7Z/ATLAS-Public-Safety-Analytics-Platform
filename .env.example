POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_only

# ATLAS Analytics API (Fase 5)
# Dentro do docker-compose, o serviço `api` sobrescreve POSTGRES_HOST/PORT
# para postgres:5432 (rede interna Docker) — estes valores acima (localhost:5433)
# valem para rodar a API direto no Windows/host, fora do container.
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Fase 6/7 — engine do banco.
#   postgres (padrão): desenvolvimento / engenharia de dados
#   duckdb           : produção (serving read-only sobre atlas_public.duckdb)
# DATABASE_ENGINE=duckdb
# DUCKDB_PATH=data/production/atlas_public.duckdb
